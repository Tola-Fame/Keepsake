# All variables are optional. Without them, Keepsake runs in "browser-only" mode:
# albums and photos are stored in the visitor's browser (IndexedDB) and no sign-in is shown.
# Set all of DATABASE_URL, AUTH_SECRET and BLOB_READ_WRITE_TOKEN to enable accounts,
# cloud-saved albums, share links and guest uploads.

# Postgres (Neon). Added automatically when you connect Neon from the Vercel Marketplace.
DATABASE_URL=

# Vercel Blob. Added automatically when you create a Blob store in the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Random secret for sign-in sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic-link sign-in (optional). API key from https://resend.com
AUTH_RESEND_KEY=
# Sender address on a domain verified in Resend, e.g. "Keepsake <hello@yourdomain.com>"
AUTH_EMAIL_FROM=
