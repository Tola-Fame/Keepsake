# All variables are optional. Without them, Keepsake runs in "browser-only" mode:
# albums and photos are stored in the visitor's browser (IndexedDB) and no sign-in is shown.
# Set DATABASE_URL and BLOB_READ_WRITE_TOKEN, plus Google and/or Resend keys, to enable
# accounts, cloud-saved albums, share links and guest uploads.

# Postgres (Neon). Added automatically when you connect Neon from the Vercel Marketplace.
DATABASE_URL=

# Vercel Blob. Added automatically when you create a Blob store in the Vercel project.
BLOB_READ_WRITE_TOKEN=
# Newer stores are connected with BLOB_STORE_ID instead (no token); both are supported.
BLOB_STORE_ID=

# Optional. Secret for sign-in sessions. If empty, one is derived from the keys above.
AUTH_SECRET=

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic-link sign-in (optional). API key from https://resend.com
AUTH_RESEND_KEY=
# Sender address on a domain verified in Resend, e.g. "Keepsake <hello@yourdomain.com>"
AUTH_EMAIL_FROM=

# Optional. Email address shown on the Privacy policy and Terms pages for questions.
CONTACT_EMAIL=

# Optional. Shows a "Google Photos" button for adding photos. Uses the Google sign-in key above;
# turn on the Google Photos Picker API for it first (see SETUP-GUIDE.md, Part 5).
GOOGLE_PHOTOS=

# Team members who can manage print orders and vendors at /admin. Comma-separated emails;
# each person signs in with that email.
ADMIN_EMAILS=
